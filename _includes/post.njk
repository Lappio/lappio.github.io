<!doctype html>
<html lang="{{ language }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f6f2" />
    <meta name="description" content="{{ summary }}" />
    <title>{{ title }} · Lappio Blog</title>
    <link rel="icon" href="../../favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../../styles.css" />
    <script src="../../script.js" defer></script>
  </head>
  <body data-page="post" data-root-prefix="../../" data-post-title="{{ title }}">
    <a class="skip-link" href="#main" data-i18n="skipLink">Skip to content</a>
    <div class="page-shell">
      <header class="site-header" id="top">
        <a class="brand" href="../../" aria-label="Lappio Blog home"><span class="brand-mark">L<span class="brand-dot">.</span></span><span>Lappio Blog</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="../../blog/" data-i18n="navBlog">Blog</a>
          <a href="../../notes/" data-i18n="navNotes">Notes</a>
          <a href="../../projects/" data-i18n="navProjects">Projects</a>
          <a href="../../links/" data-i18n="navLinks">Links</a>
          <a href="../../about/" data-i18n="navAbout">About</a>
          <a href="../../contact/" data-i18n="navContact">Contact</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button" id="search-open" type="button" aria-label="Search" title="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          </button>
          <button class="language-button" id="language-toggle" type="button" aria-label="Switch to Chinese">EN <span aria-hidden="true">/</span> 中</button>
        </div>
      </header>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="../../blog/" data-i18n="navBlog">Blog</a><a href="../../notes/" data-i18n="navNotes">Notes</a><a href="../../projects/" data-i18n="navProjects">Projects</a><a href="../../links/" data-i18n="navLinks">Links</a><a href="../../about/" data-i18n="navAbout">About</a><a href="../../contact/" data-i18n="navContact">Contact</a>
      </nav>
      <main id="main" class="interior-main post-main">
        <div class="breadcrumbs"><a href="../../" data-i18n="homeLabel">Home</a><span aria-hidden="true">/</span><a href="../../blog/" data-i18n="navBlog">Blog</a></div>
        <article class="post-article" lang="{{ language }}">
          <header class="post-header">
            <p class="section-kicker" data-i18n="writing">WRITING</p>
            <h1>{{ title }}</h1>
            <p class="post-summary">{{ summary }}</p>
            <time datetime="{{ date }}">{{ date }}</time>
          </header>
          <div class="post-body">{{ content | safe }}</div>
        </article>
        <a class="next-page-link" href="../../blog/"><span><small data-i18n="upNext">UP NEXT</small><strong data-i18n="allWriting">All writing</strong></span><span aria-hidden="true">↗</span></a>
      </main>
      <footer class="site-footer"><span>© <span id="year">2026</span> Lappio Blog</span><span data-i18n="footerNote">Made with curiosity, one page at a time.</span><a href="#top" data-i18n="backTop">Back to top ↑</a></footer>
    </div>
    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title"><div class="search-box"><div class="search-topline"><div><p class="section-kicker" data-i18n="searchKicker">FIND SOMETHING</p><h2 id="search-title" data-i18n="searchTitle">Search the site</h2></div><button type="button" id="search-close" class="close-button" aria-label="Close search">×</button></div><label class="search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="search-input" type="search" autocomplete="off" data-placeholder-en="Search posts, notes, projects..." data-placeholder-zh="搜索文章、笔记、项目……" /></label><div id="search-results" class="search-results" aria-live="polite"></div><p class="search-help" data-i18n="searchHelp">Press Esc to close</p></div></dialog>
  </body>
</html>
